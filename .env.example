# Copia este archivo como ".env" y reemplaza los valores.
# NUNCA subas el .env real a un repositorio.

FLASK_ENV=development
FLASK_DEBUG=1

# --- PostgreSQL ---
# Formato: postgresql://usuario:password@host:puerto/nombre_bd
DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/reporte_ciudadano

# --- JWT ---
# Genera una clave real con: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=cambia_esto_por_una_clave_larga_y_aleatoria

# --- SMTP (lo dejamos preparado, aunque siga pendiente) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=1
MAIL_USERNAME=
MAIL_PASSWORD=

# --- CORS ---
# "*" permite cualquier origen — SOLO para desarrollo. En producción,
# reemplaza por el dominio real del frontend, separando varios con coma:
# ALLOWED_ORIGINS=https://reporteciudadano.pe,https://www.reporteciudadano.pe
ALLOWED_ORIGINS=*
